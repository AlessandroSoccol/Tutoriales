 # nginx / nginx . conf
2
3 # 1. Definimos nuestro sistema backend ( Django + Gunicorn )
4 # El nombre ’web ’ debe coincidir con el nombre del servicio en docker -
compose
5 upstream django_backend {
6 server web :8000;
1
7 }
8
9 server {
10 # Nginx escuchara en el puerto web estandar (80)
11 listen 80;
12
13 # Ignorar logs de favicon para no saturar el servidor
14 location = / favicon . ico { access_log off ; log_not_found off ; }
15
16 # 2. Proxy Inverso : Todo el trafico raiz va al backend de Django
17 location / {
18 proxy_pass http :// django_backend ;
19 proxy_set_header X - Forwarded - For $proxy_add_x_forwarded_for ;
20 proxy_set_header Host $host ;
21 proxy_redirect off ;
22 }
23
24 # Nota Arquitectonica : En el futuro , aqui agregaremos una nueva
25 # regla ’ location / api / v2 / ’ que apuntara a nuestro microservicio
Flask
26 # para ejecutar el Strangler Pattern .
27 }