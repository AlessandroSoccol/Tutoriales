# nginx/nginx.conf
 
# Backend (Django + Gunicorn). "web" debe coincidir con el nombre del servicio en docker-compose
upstream django_backend {
    server web:8000;
}
 
server {
    # Nginx escucha en el puerto web estándar (HTTP)
    listen 80;
 
    # No saturar los logs con el favicon
    location = /favicon.ico { access_log off; log_not_found off; }
 
    # Proxy inverso: todo el tráfico raíz va a Django
    location / {
        proxy_pass http://django_backend;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_redirect off;
    }
 
    # Nota arquitectónica: aquí se agregará 'location /api/v2/' hacia el
    # microservicio Flask para aplicar el Strangler Pattern.
}
 